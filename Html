<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>SkillTrack &ndash; Employment &amp; Skilling Impact Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ===== SkillTrack design tokens ===== */
:root{
  --bg:#F5F7FB; --surface:#FFFFFF; --surface-2:#F0F2F8; --surface-3:#E9ECF6;
  --border:#E3E7F0; --border-soft:#EDF0F7;
  --ink:#10162B; --ink-soft:#4B5573; --ink-faint:#8891AA;
  --blue:#2F5CFF; --blue-ink:#1638C4; --blue-soft:#EAEFFF;
  --purple:#7C4DFF; --purple-ink:#5A2FE0; --purple-soft:#F1ECFF;
  --green:#17A673; --green-ink:#0E7C57; --green-soft:#E3F7EF;
  --amber:#DE8A1F; --amber-ink:#A9640F; --amber-soft:#FCF0DE;
  --red:#E5484D; --red-ink:#B02328; --red-soft:#FCE7E8;
  --radius-lg:22px; --radius-md:14px; --radius-sm:10px;
  --shadow-sm:0 1px 2px rgba(16,22,43,.05);
  --shadow-md:0 10px 28px -14px rgba(16,22,43,.22);
  --shadow-lg:0 24px 60px -24px rgba(16,22,43,.28);
  --sidebar-w:264px;
}
html[data-theme="dark"]{
  --bg:#0A0D18; --surface:#12172A; --surface-2:#171D33; --surface-3:#1D243F;
  --border:#252C48; --border-soft:#1D2338;
  --ink:#EEF0F9; --ink-soft:#AEB6D4; --ink-faint:#727AA0;
  --blue-soft:rgba(47,92,255,.18); --purple-soft:rgba(124,77,255,.18);
  --green-soft:rgba(23,166,115,.18); --amber-soft:rgba(222,138,31,.18);
  --red-soft:rgba(229,72,77,.18);
  --shadow-sm:0 1px 2px rgba(0,0,0,.4);
  --shadow-md:0 10px 28px -14px rgba(0,0,0,.55);
  --shadow-lg:0 24px 60px -24px rgba(0,0,0,.7);
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0; background:var(--bg); color:var(--ink);
  font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  -webkit-font-smoothing:antialiased;
  transition:background .25s ease, color .25s ease;
}
h1,h2,h3,h4,.font-display{font-family:'Space Grotesk','Inter',sans-serif; letter-spacing:-0.01em;}
a{color:inherit}
button{font-family:inherit}
::selection{background:var(--blue); color:#fff}

/* ===== App shell ===== */
.app-shell{display:flex; min-height:100vh}
.sidebar{
  width:var(--sidebar-w); flex-shrink:0; background:var(--surface);
  border-right:1px solid var(--border); position:fixed; top:0; left:0; bottom:0;
  display:flex; flex-direction:column; z-index:40; transition:transform .28s ease, background .25s ease, border-color .25s ease;
}
.sidebar-brand{display:flex; align-items:center; gap:10px; padding:22px 22px 18px 22px}
.brand-mark{
  width:34px; height:34px; border-radius:10px; flex-shrink:0;
  background:linear-gradient(135deg,var(--blue),var(--purple));
  display:flex; align-items:center; justify-content:center; color:#fff;
}
.brand-name{font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:17px; line-height:1.1}
.brand-sub{font-size:10.5px; color:var(--ink-faint); letter-spacing:.03em}
.sidebar-nav{flex:1; overflow-y:auto; padding:6px 14px}
.nav-group-label{font-size:10.5px; color:var(--ink-faint); text-transform:uppercase; letter-spacing:.08em; padding:16px 10px 8px}
.nav-item{
  display:flex; align-items:center; gap:11px; padding:9px 12px; border-radius:11px;
  color:var(--ink-soft); font-size:13.8px; font-weight:500; cursor:pointer; margin-bottom:2px;
  border:none; background:transparent; width:100%; text-align:left;
}
.nav-item:hover{background:var(--surface-2); color:var(--ink)}
.nav-item.active{background:var(--blue-soft); color:var(--blue-ink)}
html[data-theme="dark"] .nav-item.active{color:#AFC0FF}
.nav-item .nav-ic{flex-shrink:0; opacity:.9}
.sidebar-foot{padding:14px; border-top:1px solid var(--border-soft)}
.sidebar-cta{
  background:var(--surface-2); border-radius:var(--radius-md); padding:14px; font-size:12px; color:var(--ink-soft);
}
.sidebar-cta b{color:var(--ink); font-family:'Space Grotesk',sans-serif; font-size:13px}

.sidebar-backdrop{position:fixed; inset:0; background:rgba(8,10,20,.45); z-index:35; display:none}

.main-col{flex:1; margin-left:var(--sidebar-w); display:flex; flex-direction:column; min-width:0}
.topbar{
  position:sticky; top:0; z-index:30; display:flex; align-items:center; gap:14px;
  padding:14px 28px; background:color-mix(in srgb, var(--bg) 82%, transparent);
  backdrop-filter:blur(10px); border-bottom:1px solid var(--border);
}
.hamburger{display:none; background:var(--surface); border:1px solid var(--border); border-radius:10px; width:36px; height:36px; align-items:center; justify-content:center; cursor:pointer; color:var(--ink-soft)}
.page-heading{font-family:'Space Grotesk',sans-serif; font-size:19px; font-weight:600}
.page-sub{font-size:12px; color:var(--ink-faint); margin-top:1px}
.topbar-search{
  display:flex; align-items:center; gap:8px; background:var(--surface); border:1px solid var(--border);
  border-radius:999px; padding:8px 14px; width:280px; color:var(--ink-faint); font-size:13px;
}
.topbar-search input{border:none; outline:none; background:transparent; font-size:13px; color:var(--ink); width:100%; font-family:inherit}
.topbar-spacer{flex:1}
.icon-btn{
  width:38px; height:38px; border-radius:11px; border:1px solid var(--border); background:var(--surface);
  display:flex; align-items:center; justify-content:center; cursor:pointer; color:var(--ink-soft); position:relative; flex-shrink:0;
}
.icon-btn:hover{color:var(--ink); border-color:var(--ink-faint)}
.dot-badge{position:absolute; top:7px; right:7px; width:7px; height:7px; border-radius:50%; background:var(--red); border:1.5px solid var(--surface)}
.profile-chip{display:flex; align-items:center; gap:9px; padding:5px 10px 5px 5px; border-radius:999px; border:1px solid var(--border); background:var(--surface); cursor:pointer}
.avatar{width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg,var(--green),var(--blue)); display:flex; align-items:center; justify-content:center; color:#fff; font-size:12px; font-weight:700; font-family:'Space Grotesk',sans-serif}
.profile-name{font-size:12.5px; font-weight:600}
.profile-role{font-size:10.5px; color:var(--ink-faint)}

.dropdown-panel{
  position:absolute; top:48px; right:0; background:var(--surface); border:1px solid var(--border);
  border-radius:var(--radius-md); box-shadow:var(--shadow-lg); width:280px; padding:8px; z-index:50;
}
.dropdown-title{font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-faint); padding:8px 10px 4px}
.notif-item{padding:10px; border-radius:10px; display:flex; gap:10px; font-size:12.5px}
.notif-item:hover{background:var(--surface-2)}
.notif-dot{width:7px; height:7px; border-radius:50%; margin-top:5px; flex-shrink:0}
.menu-item{padding:9px 10px; border-radius:8px; font-size:13px; cursor:pointer; color:var(--ink-soft)}
.menu-item:hover{background:var(--surface-2); color:var(--ink)}

.content{padding:26px 28px 60px; max-width:1360px; width:100%; margin:0 auto}

/* ===== Buttons ===== */
.btn{
  display:inline-flex; align-items:center; gap:8px; font-weight:600; font-size:13.5px;
  padding:11px 18px; border-radius:12px; border:1px solid transparent; cursor:pointer; font-family:inherit;
  transition:transform .12s ease, box-shadow .12s ease;
}
.btn:active{transform:translateY(1px)}
.btn-primary{background:var(--ink); color:var(--bg)}
html[data-theme="dark"] .btn-primary{background:linear-gradient(135deg,var(--blue),var(--purple)); color:#fff}
.btn-primary:hover{box-shadow:var(--shadow-md)}
.btn-ghost{background:var(--surface); border-color:var(--border); color:var(--ink)}
.btn-ghost:hover{border-color:var(--ink-faint)}
.btn-soft{background:var(--blue-soft); color:var(--blue-ink)}
.btn-sm{padding:8px 13px; font-size:12.5px; border-radius:10px}

/* ===== Cards / sections ===== */
.card{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); box-shadow:var(--shadow-sm)}
.card-pad{padding:22px}
.card-title{font-family:'Space Grotesk',sans-serif; font-size:15px; font-weight:600}
.card-desc{font-size:12px; color:var(--ink-faint); margin-top:2px}
.card-head{display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:18px}

.grid{display:grid; gap:18px}
.grid-4{grid-template-columns:repeat(4,1fr)}
.grid-3{grid-template-columns:repeat(3,1fr)}
.grid-2{grid-template-columns:repeat(2,1fr)}
@media(max-width:1100px){.grid-4{grid-template-columns:repeat(2,1fr)} .grid-3{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.grid-4,.grid-3,.grid-2{grid-template-columns:1fr}}

/* ===== Stat card ===== */
.stat-card{padding:20px; border-radius:var(--radius-lg); background:var(--surface); border:1px solid var(--border); box-shadow:var(--shadow-sm); position:relative; overflow:hidden}
.stat-top{display:flex; align-items:center; justify-content:space-between; margin-bottom:14px}
.stat-ic{width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center}
.stat-label{font-size:12px; color:var(--ink-faint); font-weight:500}
.stat-value{font-family:'Space Grotesk',sans-serif; font-size:27px; font-weight:600; line-height:1; margin-top:2px}
.stat-trend{display:inline-flex; align-items:center; gap:4px; font-size:11.5px; font-weight:600; margin-top:10px; padding:3px 8px; border-radius:999px}
.trend-up{color:var(--green-ink); background:var(--green-soft)}
.trend-down{color:var(--red-ink); background:var(--red-soft)}
.trend-flat{color:var(--ink-faint); background:var(--surface-2)}

/* ===== Badges ===== */
.badge{display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:600; padding:4px 9px; border-radius:999px; white-space:nowrap}
.badge-blue{background:var(--blue-soft); color:var(--blue-ink)}
.badge-purple{background:var(--purple-soft); color:var(--purple-ink)}
.badge-green{background:var(--green-soft); color:var(--green-ink)}
.badge-amber{background:var(--amber-soft); color:var(--amber-ink)}
.badge-red{background:var(--red-soft); color:var(--red-ink)}
.badge-grey{background:var(--surface-2); color:var(--ink-soft)}

/* ===== Progress / bars ===== */
.track{height:9px; border-radius:999px; background:var(--surface-3); overflow:hidden; position:relative}
.fill{height:100%; border-radius:999px}
.hbar-row{display:grid; grid-template-columns:132px 1fr 46px; align-items:center; gap:12px; padding:8px 0}
.hbar-row + .hbar-row{border-top:1px solid var(--border-soft)}
.hbar-label{font-size:12.5px; color:var(--ink-soft); font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.hbar-val{font-size:12.5px; font-weight:700; text-align:right; font-family:'Space Grotesk',sans-serif}

/* ===== Vertical grouped bars ===== */
.vbars-wrap{display:flex; align-items:flex-end; gap:22px; height:200px; padding:0 4px 0; overflow-x:auto}
.vbars-item{display:flex; flex-direction:column; align-items:center; gap:8px; min-width:58px; height:100%; justify-content:flex-end}
.vbars-cols{display:flex; align-items:flex-end; gap:5px; height:160px}
.vbar{width:15px; border-radius:6px 6px 3px 3px; position:relative}
.vbars-cat{font-size:11px; color:var(--ink-faint); text-align:center; max-width:70px}

/* ===== Legend ===== */
.legend{display:flex; align-items:center; gap:16px; flex-wrap:wrap}
.legend-item{display:flex; align-items:center; gap:7px; font-size:12px; color:var(--ink-soft)}
.legend-dot{width:9px; height:9px; border-radius:3px}

/* ===== Donut ===== */
.donut-wrap{display:flex; align-items:center; gap:24px; flex-wrap:wrap}
.donut-legend{flex:1; min-width:150px; display:flex; flex-direction:column; gap:10px}
.donut-legend-row{display:flex; align-items:center; gap:9px; font-size:12.5px}
.donut-legend-row b{margin-left:auto; font-family:'Space Grotesk',sans-serif}

/* ===== Funnel ===== */
.funnel{display:flex; flex-direction:column; align-items:center; gap:0; padding:6px 0}
.funnel-stage{width:100%; display:flex; flex-direction:column; align-items:center}
.funnel-bar{
  display:flex; align-items:center; justify-content:center; flex-direction:column; color:#fff;
  padding:14px 10px; border-radius:12px; font-family:'Space Grotesk',sans-serif; margin:0 auto;
}
.funnel-bar .fn-count{font-size:19px; font-weight:700}
.funnel-bar .fn-label{font-size:11.5px; font-weight:500; opacity:.92; font-family:'Inter',sans-serif}
.funnel-drop{font-size:11px; color:var(--ink-faint); padding:6px 0; display:flex; align-items:center; gap:5px}

/* ===== Insights ===== */
.insight-row{display:flex; gap:12px; align-items:flex-start; padding:13px 14px; border-radius:var(--radius-md); border:1px solid var(--border-soft); background:var(--surface-2)}
.insight-ic{width:30px; height:30px; border-radius:9px; display:flex; align-items:center; justify-content:center; flex-shrink:0}
.insight-text{font-size:13px; color:var(--ink); line-height:1.5}
.insight-text b{font-family:'Space Grotesk',sans-serif}

/* ===== Table ===== */
.table-wrap{overflow-x:auto; border-radius:var(--radius-md); border:1px solid var(--border)}
table.dtable{width:100%; border-collapse:collapse; font-size:12.8px; min-width:920px}
table.dtable thead th{
  text-align:left; padding:11px 14px; background:var(--surface-2); color:var(--ink-faint);
  font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:.04em; white-space:nowrap; position:sticky; top:0;
}
table.dtable tbody td{padding:11px 14px; border-top:1px solid var(--border-soft); white-space:nowrap; color:var(--ink-soft)}
table.dtable tbody tr{cursor:pointer}
table.dtable tbody tr:hover{background:var(--surface-2)}
.name-cell{color:var(--ink); font-weight:600}
.skill-tag{display:inline-block; background:var(--surface-3); color:var(--ink-soft); font-size:10.5px; padding:2px 7px; border-radius:6px; margin:1px 3px 1px 0}

/* ===== Form controls ===== */
.select, .field-input{
  padding:9px 12px; border-radius:10px; border:1px solid var(--border); background:var(--surface);
  color:var(--ink); font-size:12.8px; font-family:inherit; outline:none;
}
.select:focus, .field-input:focus{border-color:var(--blue)}
.field-label{font-size:11px; color:var(--ink-faint); font-weight:600; text-transform:uppercase; letter-spacing:.04em; margin-bottom:6px; display:block}
.filter-bar{display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end}

/* ===== Hero ===== */
.hero{
  border-radius:28px; padding:56px 44px; position:relative; overflow:hidden;
  background:radial-gradient(circle at 15% 20%, var(--blue-soft), transparent 55%),
             radial-gradient(circle at 85% 0%, var(--purple-soft), transparent 50%),
             var(--surface);
  border:1px solid var(--border);
}
.hero-eyebrow{display:inline-flex; align-items:center; gap:7px; font-size:12px; font-weight:600; color:var(--blue-ink); background:var(--blue-soft); padding:6px 12px; border-radius:999px; margin-bottom:22px}
.hero h1{font-size:44px; line-height:1.08; max-width:760px; margin:0 0 18px; font-weight:600}
.hero p.hero-sub{font-size:16px; color:var(--ink-soft); max-width:560px; line-height:1.55; margin:0 0 30px}
.hero-actions{display:flex; gap:12px; flex-wrap:wrap}

.flow-row{display:flex; align-items:center; gap:0; margin-top:52px; flex-wrap:wrap}
.flow-node{display:flex; flex-direction:column; align-items:center; gap:10px; width:150px}
.flow-ic{width:56px; height:56px; border-radius:16px; display:flex; align-items:center; justify-content:center; box-shadow:var(--shadow-sm)}
.flow-label{font-size:13px; font-weight:600; text-align:center}
.flow-arrow{flex:1; min-width:24px; height:2px; background:linear-gradient(90deg, var(--border), var(--ink-faint), var(--border)); position:relative; top:-24px}

.section-block{margin-top:34px}
.section-head{margin-bottom:16px}
.section-head h2{font-size:21px; margin:0 0 4px; font-weight:600}
.section-head p{font-size:13px; color:var(--ink-faint); margin:0; max-width:640px}

.reason-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:14px}
@media(max-width:760px){.reason-grid{grid-template-columns:1fr}}
.reason-card{padding:18px; border-radius:var(--radius-md); background:var(--surface); border:1px solid var(--border)}
.reason-card .r-ic{width:32px; height:32px; border-radius:9px; display:flex; align-items:center; justify-content:center; margin-bottom:12px}
.reason-card h4{margin:0 0 6px; font-size:14px}
.reason-card p{margin:0; font-size:12.5px; color:var(--ink-faint); line-height:1.5}

/* ===== Initiative cards ===== */
.init-card{padding:22px; border-radius:var(--radius-lg); background:var(--surface); border:1px solid var(--border); box-shadow:var(--shadow-sm)}
.init-head{display:flex; align-items:center; justify-content:between; gap:12px; margin-bottom:16px}
.ring{width:64px; height:64px; border-radius:50%; display:flex; align-items:center; justify-content:center; position:relative; flex-shrink:0}
.ring-inner{width:50px; height:50px; border-radius:50%; background:var(--surface); display:flex; align-items:center; justify-content:center; flex-direction:column}
.ring-score{font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:15px; line-height:1}
.ring-max{font-size:8px; color:var(--ink-faint)}
.init-metrics{display:grid; grid-template-columns:1fr 1fr; gap:11px 16px; margin-top:16px}
.imv-label{font-size:10.5px; color:var(--ink-faint); text-transform:uppercase; letter-spacing:.03em}
.imv-value{font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:14.5px; margin-top:2px}

/* ===== Modal ===== */
.modal-backdrop{position:fixed; inset:0; background:rgba(8,10,20,.55); z-index:80; display:flex; align-items:center; justify-content:center; padding:20px}
.modal{background:var(--surface); border-radius:var(--radius-lg); border:1px solid var(--border); width:100%; max-width:560px; max-height:88vh; overflow-y:auto; box-shadow:var(--shadow-lg)}
.modal-head{display:flex; align-items:flex-start; justify-content:space-between; padding:22px 22px 12px}
.modal-body{padding:0 22px 22px}
.timeline{display:flex; flex-direction:column; gap:0; margin-top:14px}
.tl-row{display:flex; gap:12px}
.tl-dotcol{display:flex; flex-direction:column; align-items:center}
.tl-dot{width:14px; height:14px; border-radius:50%; flex-shrink:0; margin-top:3px}
.tl-line{width:2px; flex:1; background:var(--border); min-height:22px}
.tl-content{padding-bottom:20px; flex:1}
.tl-title{font-size:13px; font-weight:600}
.tl-sub{font-size:11.5px; color:var(--ink-faint); margin-top:1px}

/* ===== Report preview ===== */
.report-sheet{padding:26px; border-radius:var(--radius-lg); border:1px dashed var(--border); background:var(--surface-2)}
.report-stat{display:flex; justify-content:space-between; padding:10px 0; border-top:1px solid var(--border-soft); font-size:13px}
.report-stat b{font-family:'Space Grotesk',sans-serif}

@media print{
  .sidebar,.topbar,.no-print{display:none !important}
  .main-col{margin-left:0 !important}
  body{background:#fff}
}

/* ===== Responsive ===== */
@media(max-width:980px){
  .sidebar{transform:translateX(-100%)}
  .sidebar.open{transform:translateX(0)}
  .sidebar-backdrop.show{display:block}
  .main-col{margin-left:0}
  .hamburger{display:flex}
  .topbar-search{display:none}
  .hero h1{font-size:32px}
  .hero{padding:36px 24px}
}
@media(max-width:640px){
  .content{padding:18px 14px 50px}
  .card-pad{padding:16px}
  .profile-name,.profile-role{display:none}
}
</style>
</head>
<body>
<div id="root"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.28.4/babel.min.js"></script>

<script type="text/babel" data-presets="react">
const { useState, useEffect, useRef, useMemo } = React;

/* ============ ICONS (hand-drawn line set, no external dep) ============ */
const ICON_PATHS = {
  home: "M4 11.5 12 4l8 7.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1z",
  grid: "M4 4h7v7H4zM13 4h7v7h-7zM4
function StatCard({ icon, iconBg, iconColor, label, value, trend, trendDir = "up" }) {
  return (
    <div className="stat-card">
      <div className="stat-top">
        <div>
          <div className="stat-label">{label}</div>
          <div className="stat-value">{value}</div>
        </div>
        <div className="stat-ic" style={{ background: iconBg }}>
          <Icon name={icon} size={17} color={iconColor} />
        </div>
      </div>
      {trend && (
        <span className={"stat-trend " + (trendDir === "up" ? "trend-up" : trendDir === "down" ? "trend-down" : "trend-flat")}>
