function OutcomesPage() {
  const [filters, setFilters] = useState({ gender: "All", age: "All", location: "All", program: "All", industry: "All", education: "All" });
  const set = (k, v) => setFilters(f => ({ ...f, [k]: v }));

  const programAdj = filters.program === "All" ? 1 : (PROGRAMS.find(p => p.label === filters.program).employmentRate / 60);
  const locAdj = filters.location === "All" ? 1 : (LOCATIONS.find(l => l.label === filters.location).value / 60);
  const factor = clamp(programAdj * locAdj, 0.55, 1.35);

  const stages = FUNNEL_BASE.map((s, i) => ({ ...s, value: i === 0 ? s.value : Math.round(s.value * (i <= 2 ? 1 : factor)) }));

  const cards = [
    { label: "Trained", value: stages[0].value, icon: "book" },
    { label: "Certified", value: stages[1].value, icon: "award" },
    { label: "Interviewed", value: stages[2].value, icon: "users" },
    { label: "Employed", value: stages[3].value, icon: "briefcase" },
    { label: "Retained \u2013 6 mo.", value: stages[4].value, icon: "checkCircle" },
    { label: "Retained \u2013 12 mo.", value: stages[5].value, icon: "trendingUp" },
  ];

  const FilterSelect = ({ k, label, options }) => (
    <div>
      <label className="field-label">{label}</label>
      <select className="select" value={filters[k]} onChange={e => set(k, e.target.value)}>
        <option>All</option>
        {options.map(o => <option key={o}>{o}</option>)}
      </select>
    </div>
  );

  return (
    <div>
      <div className="card card-pad">
        <div className="card-head"><div><div className="card-title">Filter outcomes</div><div className="card-desc">Numbers below the funnel recompute for program &amp; location</div></div></div>
        <div className="filter-bar">
          <FilterSelect k="gender" label="Gender" options={["Female", "Male"]} />
          <FilterSelect k="age" label="Age group" options={["18\u201324", "25\u201330", "31\u201335", "36+"]} />
          <FilterSelect k="location" label="Location" options={LOCATIONS.map(l => l.label)} />
          <FilterSelect k="program" label="Training program" options={PROGRAMS.map(p => p.label)} />
          <FilterSelect k="industry" label="Industry" options={INDUSTRIES} />
          <FilterSelect k="education" label="Education level" options={EDUCATION} />
        </div>
      </div>

      <div className="section-block">
        <ChartCard title="Employment funnel" desc="From training completion to long-term retention \u2014 this is where the core problem shows up">
          <FunnelChart stages={stages} colors={FUNNEL_COLORS} />
        </ChartCard>
      </div>

      <div className="grid grid-3 section-block">
        {cards.map((c, i) => (
          <StatCard key={i} icon={c.icon}
            iconBg={i % 2 ? "var(--purple-soft)" : "var(--blue-soft)"} iconColor={i % 2 ? "var(--purple-ink)" : "var(--blue-ink)"}
            label={c.label} value={fmtNum(c.value)}
