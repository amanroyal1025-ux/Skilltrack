        <div className="modal-body">
          <div className="grid grid-2" style={{ marginBottom: 16 }}>
            <div><div className="imv-label">Program</div><div className="imv-value" style={{ fontSize: 13 }}>{c.program}</div></div>
            <div><div className="imv-label">Education</div><div className="imv-value" style={{ fontSize: 13 }}>{c.education}</div></div>
            <div><div className="imv-label">Status</div><div style={{ marginTop: 3 }}><Badge tone={statusTone(c.status)}>{c.status}</Badge></div></div>
            <div><div className="imv-label">Salary</div><div className="imv-value" style={{ fontSize: 13 }}>{c.salary ? fmtINR(c.salary) : "Not yet employed"}</div></div>
            <div><div className="imv-label">Industry / Company</div><div className="imv-value" style={{ fontSize: 13 }}>{c.industry}</div></div>
            <div><div className="imv-label">Primary skill gap</div><div className="imv-value" style={{ fontSize: 13 }}>{c.skillGap}</div></div>
          </div>
          <div>
            <div className="imv-label" style={{ marginBottom: 4 }}>Skills</div>
            <div>{c.skills.map(s => <span className="skill-tag" key={s}>{s}</span>)}</div>
          </div>

          <div className="imv-label" style={{ marginTop: 20, marginBottom: 2 }}>Outcome timeline</div>
          <div className="timeline">
            {stages.map((s, i) => (
              <div className="tl-row" key={i}>
                <div className="tl-dotcol">
                  <div className="tl-dot" style={{ background: s.done ? "var(--green)" : "var(--surface-3)" }} />
                  {i < stages.length - 1 && <div className="tl-line" />}
                </div>
                <div className="tl-content">
                  <div className="tl-title" style={{ color: s.done ? "var(--ink)" : "var(--ink-faint)" }}>{s.t}</div>
                  {!s.done && i > 0 && stages[i - 1].done && <div className="tl-sub">Drop-off point</div>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}
/* ============ EMPLOYER DEMAND ============ */
function EmployerPage() {
  const sorted = [...EMPLOYER_DEMAND].sort((a, b) => b.gap - a.gap);
  return (
    <div>
      <div className="grid grid-2">
        <ChartCard title="Skill demand vs. availability" desc="Employer demand level and % of candidates who currently hold the skill">
          <div className="table-wrap" style={{ border: "none" }}>
            <table className="dtable" style={{ minWidth: 0 }}>
              <thead><tr><th>Skill</th><th>Demand</th><th>Available candidates</th><th>Gap</th></tr></thead>
              <tbody>
                {EMPLOYER_DEMAND.map((r, i) => (
                  <tr key={i} style={{ cursor: "default" }}>
                    <td className="name-cell">{r.skill}</td>
                    <td><Badge tone={demandTone(r.demand)}>{r.demand}</Badge></td>
                    <td>{r.available}%</td>
                    <td style={{ color: r.gap >= 50 ? "var(--red-ink)" : "var(--ink-soft)", fontWeight: 600 }}>{r.gap}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </ChartCard>
        <ChartCard title="Largest unmet demand" desc="Skills sorted by gap, highest first">
          <HBarList data={sorted.map(s => ({ label: s.skill, value: s.gap }))} color="var(--red)" />
        </ChartCard>
      </div>

      <div className="section-block">
        <ChartCard title="Available candidates vs. gap, by skill">
          <VerticalGroupedBars
            data={EMPLOYER_DEMAND}
            seriesA={{ key: "available", label: "Available candidates", color: "var(--green)" }}
            seriesB={{ key: "gap", label: "Unmet gap", color: "var(--red)" }}
          />
        </ChartCard>
      </div>

      <div className="section-block">
        <div className="legend" style={{ marginBottom: 10 }}>
          <span className="legend-item"><Badge tone="red">Very High</Badge> employer demand outstrips supply sharply</span>
          <span className="legend-item"><Badge tone="amber">High</Badge> notable shortfall in trained candidates</span>
          <span className="legend-item"><Badge tone="blue">Medium</Badge> demand is more balanced with supply</span>
        </div>
      </div>
    </div>
  );
}

/* ============ REPORTS ============ */
function ReportsPage() {
  const [filters, setFilters] = useState({ from: "2025-10-01", to: "2026-09-12", location: "All", program: "All", industry: "All", status: "All" });
  const [report, setReport] = useState(null);
  const set = (k, v) => setFilters(f => ({ ...f, [k]: v }));

  const filteredCandidates = useMemo(() => CANDIDATES.filter(c =>
    (filters.location === "All" || c.location === filters.location) &&
    (filters.program === "All" || c.program === filters.program) &&
    (filters.industry === "All" || c.industry === filters.industry) &&
    (filters.status === "All" || c.status === filters.status)
  ), [filters]);

  function generateReport() {
    const total = filteredCandidates.length || 1;
    const employed = filteredCandidates.filter(c => c.status === "Employed").length;
    const certified = filteredCandidates.filter(c => c.certified).length;
    const salaries = filteredCandidates.filter(c => c.salary).map(c => c.salary);
    const avgSalary = salaries.length ? Math.round(salaries.reduce((a, b) => a + b, 0) / salaries.length) : 0;
    const retained6 = filteredCandidates.filter(c => c.retained6 === "Retained").length;
    const retained6base = filteredCandidates.filter(c => c.retained6 !== "\u2014").length || 1;
    setReport({
      total, employed,
      employmentRate: Math.round((employed / total) * 100),
      certificationRate: Math.round((certified / total) * 100),
      avgSalary,
      retentionRate: Math.round((retained6 / retained6base) * 100),
      skillGapAvg: Math.round(SKILLS_GAP.reduce((a, s) => a + s.gap, 0) / SKILLS_GAP.length),
      impactScore: Math.round(INITIATIVES.reduce((a, i) => a + i.impact, 0) / INITIATIVES.length),
    });
  }

  function exportCSV() {
    const header = ["ID", "Name", "Age", "Gender", "Location", "Education", "Program", "Skills", "Certified", "Status", "Industry", "Salary", "EmploymentDate", "Retained6mo", "Retained12mo"];
    const rows = filteredCandidates.map(c => [c.id, c.name, c.age, c.gender, c.location, c.education, c.program, c.skills.join("|"), c.certified, c.status, c.industry, c.salary || "", c.employmentDate, c.retained6, c.retained12]);
    const csv = [header, ...rows].map(r => r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(",")).join("\n");
    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = "skilltrack_report.csv"; a.click();
    URL.revokeObjectURL(url);
  }

  return (
    <div>
      <div className="card card-pad">
        <div className="card-head"><div><div className="card-title">Build a report</div><div className="card-desc">Filters apply to the {CANDIDATES.length}-candidate sample dataset</div></div></div>
        <div className="filter-bar">
          <div><label className="field-label">From</label><input type="date" className="field-input" value={filters.from} onChange={e => set("from", e.target.value)} /></div>
          <div><label className="field-label">To</label><input type="date" className="field-input" value={filters.to} onChange={e => set("to", e.target.value)} /></div>
          <div><label className="field-label">Location</label>
            <select className="select" value={filters.location} onChange={e => set("location", e.target.value)}>
              <option>All</option>{LOCATIONS.map(l => <option key={l.label}>{l.label}</option>)}
            </select>
          </div>
          <div><label className="field-label">Program</label>
            <select className="select" value={filters.program} onChange={e => set("program", e.target.value)}>
              <option>All</option>{PROGRAMS.map(p => <option key={p.label}>{p.label}</option>)}
            </select>
          </div>
          <div><label className="field-label">Industry</label>
            <select className="select" value={filters.industry} onChange={e => set("industry", e.target.value)}>
              <option>All</option>{INDUSTRIES.map(i => <option key={i}>{i}</option>)}
            </select>
          </div>
          <div><label className="field-label">Employment status</label>
            <select className="select" value={filters.status} onChange={e => set("status", e.target.value)}>
              <option>All</option>{STATUSES.map(s => <option key={s}>{s}</option>)}
            </select>
          </div>
        </div>
        <div style={{ display: "flex", gap: 10, marginTop: 20, flexWrap: "wrap" }} className="no-print">
          <button className="btn btn-primary" onClick={generateReport}><Icon name="file" size={15} /> Generate Report</button>
          <button className="btn btn-ghost" onClick={exportCSV}><Icon name="download" size={15} /> Export CSV</button>
          <button className="btn btn-ghost" onClick={() => window.print()}><Icon name="download" size={15} /> Download PDF</button>
        </div>
      </div>

      {report && (
        <div className="section-block">
          <div className="report-sheet">
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
              <div className="card-title">Outcome Report</div>
              <span className="card-desc">{filters.from} \u2192 {filters.to}</span>
            </div>
            <div className="card-desc" style={{ marginBottom: 6 }}>
              {filters.location} &middot; {filters.program} &middot; {filters.industry} &middot; {filters.status}
            </div>
            <div className="report-stat"><span>Candidates in scope</span><b>{fmtNum(report.total)}</b></div>
            <div className="report-stat"><span>Employment rate</span><b>{report.employmentRate}%</b></div>
            <div className="report-stat"><span>Certification rate</span><b>{report.certificationRate}%</b></div>
            <div className="report-stat"><span>Average salary (employed)</span><b>{report.avgSalary ? fmtINR(report.avgSalary) : "\u2014"}</b></div>
            <div className="report-stat"><span>6-month retention</span><b>{report.retentionRate}%</b></div>
            <div className="report-stat"><span>Average skill gap across tracked skills</span><b>{report.skillGapAvg} pts</b></div>
            <div className="report-stat"><span>Average initiative impact score</span><b>{report.impactScore} / 100</b></div>
          </div>
        </div>
      )}
    </div>
  );
}
/* ============ APP ROOT ============ */
function App() {
  const [page, setPage] = useState("home");
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [dark, setDark] = useState(false);

  useEffect(() => {
    document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
  }, [dark]);

  useEffect(() => { window.scrollTo(0, 0); }, [page]);

  const Page = {
    home: <HomePage go={setPage} />,
    dashboard: <DashboardPage />,
    skillgap: <SkillGapPage />,
    outcomes: <OutcomesPage />,
    initiatives: <InitiativesPage />,
    candidates: <CandidatesPage />,
    employer: <EmployerPage />,
    reports: <ReportsPage />,
  }[page];

  return (
    <div className="app-shell">
      <Sidebar page={page} setPage={setPage} open={sidebarOpen} setOpen={setSidebarOpen} />
      <div className="main-col">
        <Topbar page={page} onMenu={() => setSidebarOpen(true)} dark={dark} setDark={setDark} />
        <div className="content">{Page}</div>
      </div>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById("root"));
root.render(<App />);
</script>
</body>
</html>
